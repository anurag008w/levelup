+    private CharSequence renderFormattedText(String text) {
+        if (text == null || text.isEmpty()) {
+            return "";
+        }
+        try {
+            String html = text;
+            if (!html.contains("<br>") && !html.contains("<br/>") && !html.contains("<p>") && html.contains("\n")) {
+                html = html.replace("\n", "<br>");
+            }
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+                return Html.fromHtml(html, Html.FROM_HTML_MODE_LEGACY);
+            } else {
+                return Html.fromHtml(html);
+            }
+        } catch (Exception e) {
+            return text;
+        }
+    }
