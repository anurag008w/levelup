@@ -0,0 +1,55 @@
+package com.capacitorjs.plugins.localnotifications;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import com.getcapacitor.JSObject;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+/**
+ * Temporary store for notification actions (inline replies) that arrive while
+ * the app process is dead — there is no JS bridge yet, so they cannot be
+ * delivered immediately. The next time the app starts, LocalNotificationsPlugin
+ * reads and delivers this queue to the JS bridge (via load()), so a
+ * notification reply is never silently lost AND the app is never pulled to the
+ * foreground just to deliver one. The reply is processed the moment the user
+ * next opens the app.
+ */
+public class PendingNotificationActions {
+
+    private static final String PREFS = "levelup_pending_notification_actions";
+    private static final String KEY = "queue";
+
+    private PendingNotificationActions() {}
+
+    /** Saves an action (JSObject with actionId/inputValue/notification) for later delivery. */
+    public static void persist(Context context, JSObject action) {
+        try {
+            SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            String existing = prefs.getString(KEY, "[]");
+            JSONArray queue = new JSONArray(existing);
+            queue.put(new JSONObject(action.toString()));
+            prefs.edit().putString(KEY, queue.toString()).apply();
+        } catch (Exception ignored) {
+            // Best-effort — never crash the broadcast receiver.
+        }
+    }
+
+    /**
+     * Returns every queued action as a JSONArray and clears the queue. The
+     * caller (LocalNotificationsPlugin, a Plugin subclass) is responsible for
+     * delivering them to the JS bridge — notifyListeners is protected and can
+     * only be called from inside the plugin itself.
+     */
+    public static JSONArray readAndClear(Context context) {
+        try {
+            SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+            String existing = prefs.getString(KEY, "[]");
+            JSONArray queue = new JSONArray(existing);
+            prefs.edit().remove(KEY).apply();
+            return queue;
+        } catch (Exception ignored) {
+            return new JSONArray();
+        }
+    }
+}
