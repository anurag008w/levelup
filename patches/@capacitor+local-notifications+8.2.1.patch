+package com.capacitorjs.plugins.localnotifications;
+
+import android.app.NotificationManager;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import androidx.core.app.RemoteInput;
+import com.getcapacitor.JSObject;
+import org.json.JSONException;
+
+/**
+ * Receiver for inline "Reply" actions. The stock plugin launches the Activity
+ * for every action (PendingIntent.getActivity), which pulls the app to the
+ * foreground the moment the user replies from the notification. Using a
+ * broadcast PendingIntent keeps the app closed: the reply text is delivered to
+ * the JS bridge as a `localNotificationActionPerformed` event (same shape the
+ * activity-tap path produces) and the notification is dismissed so the AI's
+ * answer can replace it.
+ */
+public class NotificationActionReceiver extends BroadcastReceiver {
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        int notificationId = intent.getIntExtra(LocalNotificationManager.NOTIFICATION_INTENT_KEY, Integer.MIN_VALUE);
+        if (notificationId == Integer.MIN_VALUE) {
+            return;
+        }
+
+        JSObject dataJson = new JSObject();
+
+        Bundle results = RemoteInput.getResultsFromIntent(intent);
+        if (results != null) {
+            CharSequence input = results.getCharSequence(LocalNotificationManager.REMOTE_INPUT_KEY);
+            if (input != null) {
+                dataJson.put("inputValue", input.toString());
+            }
+        }
+        dataJson.put("actionId", intent.getStringExtra(LocalNotificationManager.ACTION_INTENT_KEY));
+
+        String notificationJsonString = intent.getStringExtra(LocalNotificationManager.NOTIFICATION_OBJ_INTENT_KEY);
+        if (notificationJsonString != null) {
+            try {
+                dataJson.put("notification", new JSObject(notificationJsonString));
+            } catch (JSONException ignored) {
+            }
+        }
+
+        boolean isRemovable = intent.getBooleanExtra(LocalNotificationManager.NOTIFICATION_IS_REMOVABLE_KEY, true);
+        NotificationStorage notificationStorage = new NotificationStorage(context);
+        if (isRemovable) {
+            notificationStorage.deleteNotification(Integer.toString(notificationId));
+        }
+
+        NotificationManager notificationManager = (NotificationManager) context.getSystemService(Context.NOTIFICATION_SERVICE);
+        if (notificationManager != null) {
+            notificationManager.cancel(notificationId);
+        }
+
+        // Deliver to the JS bridge. Agar app ka process dead tha (bridge
+        // unavailable) to action ko persist kar do — agla app start usse flush
+        // kar dega. Isse reply kabhi silently lost nahi hota aur app reply ke
+        // liye foreground me nahi aati.
+        if (!LocalNotificationsPlugin.fireActionPerformed(dataJson)) {
+            PendingNotificationActions.persist(context, dataJson);
+        }
+    }
+}
