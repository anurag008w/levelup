<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Window ka default background dark rakho — warna splash → webview
             transition ke beech (ya kisi bhi uncovered strip pe, jaise top
             cutout/status-bar area) parent Light theme ka white background
             flash hota hai. -->
        <item name="android:windowBackground">#060506</item>
        <item name="android:colorBackground">#060506</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- App dark hai (#060506) — transient status bar (swipe pe dikhta hai)
             bhi dark ho taaki white bar na dikhe. -->
        <item name="android:statusBarColor">#060506</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#060506</item>
        <item name="android:colorBackground">#060506</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- android:background sirf legacy trick hai — real window background
             attribute windowBackground hai. Isko set na karne se splash ke
             baad, jo bhi strip WebView cover nahi karta (top status-bar /
             cutout inset), uspar Theme.SplashScreen ka default (white)
             background dikhta tha. -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:colorBackground">#060506</item>
        <item name="windowSplashScreenBackground">#060506</item>
    </style>
</resources>