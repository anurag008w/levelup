# Web/build-time environment example for LevelUp.
# Copy this file to `.env`, fill in your values, then run `npm run build`.
#
# IMPORTANT: VITE_* values are embedded into the client bundle by Vite. They
# are NOT runtime secrets. Never put a real API key, password, JWT, or other
# credential in VITE_DEFAULT_AI_API_KEY (or any other VITE_* variable) for a
# public web build. Use a server-side gateway for real credentials.

# Release/version shown by the web updater. CI release builds set this from
# the release tag automatically; local production-like builds should set it.
VITE_APP_VERSION=2026.09.7004

# Default AI provider — configured at build time.
VITE_DEFAULT_AI_BASE_URL=https://smartrotator.onrender.com
VITE_DEFAULT_AI_API_KEY=your-api-key-here
VITE_DEFAULT_AI_MODEL=levelup

# Multiple models? Comma-separated list (model ids or group ids).
# Optional — if omitted, VITE_DEFAULT_AI_MODEL is used as the single model.
VITE_DEFAULT_AI_MODELS=levelup,big-pickle,gemini-3-flash-preview

# Optional:
VITE_DEFAULT_AI_TEMPERATURE=0.7
VITE_DEFAULT_AI_MAX_TOKENS=8192
VITE_DEFAULT_AI_TIMEOUT_MS=120000
