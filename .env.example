# Default (hidden) AI provider — build ke time par in vars se configure hota hai.
# Copy is file ko `.env` (ya `.env.production`) me, apni key bharo, phir `npm run build`.
# Ye provider har user ke app me automatically dikhega ("Default"), API key UI me kabhi nahi dikhti.

VITE_DEFAULT_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_DEFAULT_AI_API_KEY=your-api-key-here
VITE_DEFAULT_AI_MODEL=deepseek/deepseek-chat

# Multiple models? Comma-separated list (model ids).
# 2+ models hone par users ko chat me model picker dikhega (sirf model names — URL/key kabhi nahi).
# Sirf ek daaloge toh picker nahi dikhega, sab hidden rahega.
# Optional — agar chhoda toh VITE_DEFAULT_AI_MODEL single model ke roop me use hoga.
VITE_DEFAULT_AI_MODELS=deepseek/deepseek-chat,google/gemini-2.0-flash-001

# Optional:
VITE_DEFAULT_AI_TEMPERATURE=0.7
VITE_DEFAULT_AI_MAX_TOKENS=8192
VITE_DEFAULT_AI_TIMEOUT_MS=120000
