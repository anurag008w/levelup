# Default (hidden) AI provider — build ke time par in vars se configure hota hai.
# Copy is file ko `.env` me, apni values bharo, phir `npm run build`.
# Ye provider har user ke app me automatically use hota hai ("Default"), API key
# aur server URL UI me kabhi nahi dikhti.
#
# Login gate ke liye: VITE_DEFAULT_AI_BASE_URL hi wo server hai jahan /auth/login
# aur /auth/register hit hote hain (login screen par URL field NAHI dikhti).
# VITE_DEFAULT_AI_API_KEY sirf placeholder hai — login ke baad user ki apni sk-
# key auto-apply ho jati hai (per-user quota server pe track hota hai).

VITE_DEFAULT_AI_BASE_URL=https://smartrotator.onrender.com
VITE_DEFAULT_AI_API_KEY=your-api-key-here

# Default model = server ka Virtual Model Group ("levelup") — group ke members
# me rotation hoti hai. Agar group down ho toh picker me baaki models dikhte hain.
VITE_DEFAULT_AI_MODEL=levelup

# Multiple models? Comma-separated list (model ids ya group ids).
# 2+ models hone par users ko chat me model picker dikhega (sirf model names — URL/key kabhi nahi).
# Sirf ek daaloge toh picker nahi dikhega, sab hidden rahega.
# Optional — agar chhoda toh VITE_DEFAULT_AI_MODEL single model ke roop me use hoga.
VITE_DEFAULT_AI_MODELS=levelup,big-pickle,gemini-3-flash-preview

# Optional:
VITE_DEFAULT_AI_TEMPERATURE=0.7
VITE_DEFAULT_AI_MAX_TOKENS=8192
VITE_DEFAULT_AI_TIMEOUT_MS=120000
